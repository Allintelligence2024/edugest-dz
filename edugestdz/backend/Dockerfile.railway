FROM php:8.2-fpm-alpine

RUN apk add --no-cache \
    nginx supervisor \
    libpq-dev libpng-dev libjpeg-turbo-dev libzip-dev freetype-dev oniguruma-dev libxml2-dev \
    libpng libjpeg-turbo libzip \
    autoconf gcc g++ make

RUN docker-php-ext-configure gd --with-jpeg --with-freetype \
    && docker-php-ext-install -j$(nproc) \
        gd zip pdo pdo_pgsql pgsql mbstring xml bcmath fileinfo \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del autoconf gcc g++ make

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY . .

RUN composer install --no-dev --optimize-autoloader --no-interaction --ignore-platform-reqs --no-scripts \
    && php artisan package:discover --ansi

RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html/storage \
    && chmod -R 755 /var/www/html/bootstrap/cache

RUN rm -f /etc/nginx/http.d/default.conf
COPY railway-nginx.conf /etc/nginx/http.d/default.conf

RUN sed -i 's/;catch_workers_output = yes/catch_workers_output = yes/' /usr/local/etc/php-fpm.d/www.conf && \
    sed -i 's/;php_admin_value\[error_log\]/php_admin_value[error_log] = \/dev\/stderr/' /usr/local/etc/php-fpm.d/www.conf && \
    sed -i 's/;php_admin_flag\[log_errors\]/php_admin_flag[log_errors] = on/' /usr/local/etc/php-fpm.d/www.conf

EXPOSE 80

CMD sh -c "php-fpm -D && sleep 1 && nginx -g 'daemon off;'"
