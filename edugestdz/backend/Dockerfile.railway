FROM php:8.2-fpm-alpine

RUN apk add --no-cache \
    git curl zip unzip libpng-dev libpq-dev libzip-dev \
    oniguruma-dev libxml2-dev nginx supervisor \
    autoconf g++ make linux-headers

RUN docker-php-ext-install \
    pdo pdo_pgsql pgsql mbstring exif pcntl bcmath gd xml opcache zip

RUN pecl install redis && docker-php-ext-enable redis

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY . .

RUN composer install --no-dev --optimize-autoloader --no-interaction

RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html/storage \
    && chmod -R 755 /var/www/html/bootstrap/cache

RUN printf '[supervisord]\nnodaemon=true\nuser=root\nlogfile=/dev/stdout\nlogfile_maxbytes=0\n\n[program:php-fpm]\ncommand=php-fpm --nodaemonize\nautostart=true\nautorestart=true\nstdout_logfile=/dev/stdout\nstdout_logfile_maxbytes=0\nstderr_logfile=/dev/stderr\nstderr_logfile_maxbytes=0\n\n[program:nginx]\ncommand=nginx -g "daemon off;"\nautostart=true\nautorestart=true\nstdout_logfile=/dev/stdout\nstdout_logfile_maxbytes=0\nstderr_logfile=/dev/stderr\nstderr_logfile_maxbytes=0\n' > /etc/supervisord.conf

RUN printf 'server {\n\
    listen 80;\n\
    root /var/www/html/public;\n\
    index index.php;\n\
    location = /api/health {\n\
        access_log off;\n\
        default_type application/json;\n\
        return 200 "{\"status\":\"ok\"}";\n\
    }\n\
    location / { try_files $uri $uri/ /index.php?$query_string; }\n\
    location ~ \\.php$ {\n\
        fastcgi_pass 127.0.0.1:9000;\n\
        fastcgi_index index.php;\n\
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;\n\
        include fastcgi_params;\n\
    }\n\
}\n' > /etc/nginx/http.d/default.conf

RUN printf 'opcache.enable=1\n\
opcache.memory_consumption=256\n\
opcache.max_accelerated_files=20000\n\
upload_max_filesize=10M\n\
post_max_size=10M\n\
memory_limit=256M\n' > /usr/local/etc/php/conf.d/railway.ini

RUN chmod +x /docker-entrypoint.sh

EXPOSE 80

CMD ["sh", "-c", "php artisan key:generate --force 2>/dev/null; php artisan jwt:secret --force 2>/dev/null; php artisan migrate --force 2>/dev/null; exec /usr/bin/supervisord -c /etc/supervisord.conf"]
