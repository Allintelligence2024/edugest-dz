FROM php:8.2-fpm-alpine

RUN apk add --no-cache \
    git curl zip unzip libpng-dev libpq-dev libzip-dev \
    oniguruma-dev libxml2-dev nginx supervisor \
    autoconf g++ make linux-headers

RUN docker-php-ext-install \
    pdo pdo_pgsql pgsql mbstring exif pcntl bcmath gd xml opcache zip

RUN pecl install redis && docker-php-ext-enable redis

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY . .

RUN composer install --no-dev --optimize-autoloader --no-interaction

RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html/storage \
    && chmod -R 755 /var/www/html/bootstrap/cache

RUN cat > /etc/nginx/http.d/default.conf <<'NGINX'
server {
    listen 80;
    root /var/www/html/public;
    index index.php;

    location = /api/health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }
}
NGINX

RUN cat > /usr/local/etc/php/conf.d/railway.ini <<'PHPINI'
opcache.enable=1
opcache.memory_consumption=256
opcache.max_accelerated_files=20000
upload_max_filesize=10M
post_max_size=10M
memory_limit=256M
PHPINI

RUN cat > /etc/supervisord.conf <<'SUPERVISOR'
[supervisord]
nodaemon=true
user=root
logfile=/dev/stdout
logfile_maxbytes=0

[program:php-fpm]
command=php-fpm --nodaemonize
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:nginx]
command=nginx -g "daemon off;"
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
SUPERVISOR

EXPOSE 80

CMD sh -c "php-fpm -D 2>/dev/null; nginx -g 'daemon off;' & sleep 3; php artisan key:generate --force 2>/dev/null; php artisan jwt:secret --force 2>/dev/null; php artisan migrate --force 2>/dev/null; wait"
