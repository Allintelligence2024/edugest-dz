FROM php:8.2-fpm-alpine

RUN apk add --no-cache \
    git curl zip unzip libpng-dev libpq-dev libzip-dev \
    oniguruma-dev libxml2-dev nginx supervisor \
    autoconf g++ make linux-headers

RUN docker-php-ext-install \
    pdo pdo_pgsql pgsql mbstring exif pcntl bcmath gd xml opcache zip

RUN pecl install redis && docker-php-ext-enable redis

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY . .

RUN composer install --no-dev --optimize-autoloader --no-interaction

RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html/storage \
    && chmod -R 755 /var/www/html/bootstrap/cache

RUN echo 'server { \
    listen 80; \
    root /var/www/html/public; \
    index index.php; \
    location = /api/health { \
        access_log off; \
        default_type application/json; \
        return 200 "{\"status\":\"ok\"}"; \
    } \
    location / { try_files $uri $uri/ /index.php?$query_string; } \
    location ~ \.php$ { \
        fastcgi_pass 127.0.0.1:9000; \
        fastcgi_index index.php; \
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; \
        include fastcgi_params; \
    } \
}' > /etc/nginx/http.d/default.conf

RUN echo 'opcache.enable=1 \n\
opcache.memory_consumption=256 \n\
opcache.max_accelerated_files=20000 \n\
upload_max_filesize=10M \n\
post_max_size=10M \n\
memory_limit=256M' >> /usr/local/etc/php/conf.d/railway.ini

RUN echo '[supervisord] \
nodaemon=true \
user=root \
logfile=/dev/stdout \
logfile_maxbytes=0 \
 \
[program:php-fpm] \
command=php-fpm -D \
autostart=true \
autorestart=true \
stdout_logfile=/dev/stdout \
stdout_logfile_maxbytes=0 \
stderr_logfile=/dev/stderr \
stderr_logfile_maxbytes=0 \
 \
[program:nginx] \
command=nginx -g "daemon off;" \
autostart=true \
autorestart=true \
stdout_logfile=/dev/stdout \
stdout_logfile_maxbytes=0 \
stderr_logfile=/dev/stderr \
stderr_logfile_maxbytes=0 \
' > /etc/supervisord.conf

COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
