@@ -95,7 +100,7 @@ jobs:
           DB_PORT:       5432
           DB_DATABASE:   edugestdz_test
           DB_USERNAME:   edugest_user
-          DB_PASSWORD:   EduGest@2026!
+          DB_PASSWORD:   ${{ secrets.CI_DB_PASSWORD || 'ci-ephemeral-postgres-pwd' }}
           REDIS_HOST:    127.0.0.1
 
       - name: Run tests
@@ -106,9 +111,60 @@ jobs:
           DB_PORT:       5432
           DB_DATABASE:   edugestdz_test
           DB_USERNAME:   edugest_user
-          DB_PASSWORD:   EduGest@2026!
+          DB_PASSWORD:   ${{ secrets.CI_DB_PASSWORD || 'ci-ephemeral-postgres-pwd' }}
           REDIS_HOST:    127.0.0.1
 
+      # ── Gardes sécurité (Sprint 3) ────────────────────────────────
+      # Bloquants : une régression sur l'isolation tenant ou sur la chaîne
+      # d'audit ne doit jamais atteindre la branche principale.
+
+      - name: "Sécurité — RLS actif sur toutes les tables attendues"
+        run: php artisan rls:status --strict
+        env:
+          DB_CONNECTION: pgsql
+          DB_HOST:       127.0.0.1
+          DB_PORT:       5432
+          DB_DATABASE:   edugestdz_test
+          DB_USERNAME:   edugest_user
+          DB_PASSWORD:   ${{ secrets.CI_DB_PASSWORD || 'ci-ephemeral-postgres-pwd' }}
+          REDIS_HOST:    127.0.0.1
+
+      - name: "Sécurité — intégrité de la chaîne d'audit"
+        run: php artisan audit:verify
+        env:
+          DB_CONNECTION: pgsql
+          DB_HOST:       127.0.0.1
+          DB_PORT:       5432
+          DB_DATABASE:   edugestdz_test
+          DB_USERNAME:   edugest_user
+          DB_PASSWORD:   ${{ secrets.CI_DB_PASSWORD || 'ci-ephemeral-postgres-pwd' }}
+          REDIS_HOST:    127.0.0.1
+
+      - name: "Sécurité — aucun jeton en localStorage"
+        run: |
+          # Le jeton d'accès vit en mémoire, le refresh dans un cookie httpOnly.
+          # Toute réintroduction de localStorage pour un jeton est une régression.
+          if grep -rnE "(local|session)Storage\.(get|set)Item\(\s*['\"](access_token|refresh_token)" \
+               frontend/src mobile/src 2>/dev/null \
+               | grep -vE "^\S+: *(\*|//|#)"; then
+            echo "::error::Jeton d'authentification stocké dans localStorage/sessionStorage"
+            exit 1
+          fi
+          echo "OK — aucun jeton persisté côté navigateur"
+        working-directory: edugestdz
+
+      - name: "Sécurité — aucun secret en dur"
+        run: |
+          # Filet contre la réintroduction de mots de passe littéraux.
+          if grep -rnE "EduGest@[0-9]{4}" --include="*.yml" --include="*.yaml" \
+               --include="*.php" --include="*.env*" . 2>/dev/null \
+               | grep -vE "(vendor/|node_modules/|/tests/|docs/ci-secrets.patch)"; then
+            echo "::error::Mot de passe en dur détecté"
+            exit 1
+          fi
+          echo "OK — aucun secret littéral"
+        working-directory: .
+
       - name: Run tests with coverage
         continue-on-error: true
         run: php -d memory_limit=512M artisan test --coverage --min=30
@@ -118,6 +174,6 @@ jobs:
           DB_PORT:       5432
           DB_DATABASE:   edugestdz_test
           DB_USERNAME:   edugest_user
-          DB_PASSWORD:   EduGest@2026!
+          DB_PASSWORD:   ${{ secrets.CI_DB_PASSWORD || 'ci-ephemeral-postgres-pwd' }}
           REDIS_HOST:    127.0.0.1
           XDEBUG_MODE:   coverage
