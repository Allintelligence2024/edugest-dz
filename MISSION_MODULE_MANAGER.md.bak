## ÉTAPE 3 — Middleware ModuleCheck

**Créer :**
`edugestdz/backend/app/Http/Middleware/ModuleCheck.php`

```php
<?php

namespace App\Http\Middleware;

use App\Models\TenantModule;
use Closure;
use Illuminate\Http\Request;

/**
 * Middleware qui vérifie si le module correspondant à la route est activé.
 *
 * Mapping route_prefix → module_key :
 *   /api/v1/transport  → transport
 *   /api/v1/cantine    → cantine
 *   etc.
 *
 * Usage dans routes/api.php :
 *   Route::middleware(['auth:api', 'tenant', 'module:transport'])->group(...)
 */
class ModuleCheck
{
    // Mapping automatique : préfixe URL → module_key
    private const ROUTE_MAP = [
        'v1/transport'    => 'transport',
        'v1/cantine'      => 'cantine',
        'v1/stock'        => 'stock',
        'v1/budget'       => 'budget',
        'v1/personnel'    => 'personnel',
        'v1/entretien'    => 'entretien',
        'v1/surveillance' => 'surveillance',
        'v1/lms'          => 'lms',
        'v1/marketplace'  => 'marketplace',
        'v1/centres'      => 'marketplace',
        'v1/examens'      => 'examens',
        'v1/diagnostic'   => 'diagnostic',
        'v1/billets'      => 'billets',
        'v1/pointage'     => 'pointage',
        'v1/bibliotheque' => 'bibliotheque',
    ];

    public function handle(Request $request, Closure $next, ?string $moduleKey = null)
    {
        // Pas de vérification si pas de tenant résolu
        $tenantId = config('tenant.current_id');
        if (!$tenantId) return $next($request);

        // Pas de vérification sur health check
        if ($request->is('api/health')) return $next($request);

        // Déterminer le module depuis le paramètre ou la route
        $module = $moduleKey ?? $this->detecterModuleDepuisRoute($request->path());

        if (!$module) return $next($request); // Route non mappée → laisser passer

        // Vérifier si le module est actif
        if (!TenantModule::estActif($tenantId, $module)) {
            return response()->json([
                'success' => false,
                'message' => "Le module « {$module} » n'est pas activé pour votre établissement.",
                'code'    => 'MODULE_DISABLED',
                'module'  => $module,
                'action'  => 'Contactez votre administrateur ou activez le module dans Paramètres → Modules.',
            ], 403);
        }

        return $next($request);
    }

    private function detecterModuleDepuisRoute(string $path): ?string
    {
        foreach (self::ROUTE_MAP as $prefix => $module) {
            if (str_starts_with($path, $prefix)) {
                return $module;
            }
        }
        return null;
    }
}
```

