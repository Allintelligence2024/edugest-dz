## ÉTAPE 6 — ModuleController (API gestion des modules)

**Créer :**
`edugestdz/backend/app/Http/Controllers/Api/V1/ModuleController.php`

```php
<?php

namespace App\Http\Controllers\Api\V1;

use App\Http\Controllers\Controller;
use App\Models\TenantModule;
use Illuminate\Http\Request;
use Illuminate\Http\JsonResponse;

class ModuleController extends Controller
{
    /**
     * @OA\Get(
     *   path="/api/v1/modules",
     *   summary="État de tous les modules du tenant",
     *   tags={"Modules"},
     *   security={{"bearerAuth":{}}},
     *   @OA\Parameter(ref="#/components/parameters/TenantId"),
     *   @OA\Response(response=200, description="Liste des modules avec leur état actif/inactif")
     * )
     */
    public function index(): JsonResponse
    {
        $tenantId = config('tenant.current_id');
        $modules  = TenantModule::getEtatComplet($tenantId);

        // Grouper par catégorie
        $parCategorie = collect($modules)->groupBy('categorie')->toArray();

        return response()->json([
            'success'       => true,
            'data'          => [
                'modules'       => $modules,
                'par_categorie' => $parCategorie,
                'nb_actifs'     => collect($modules)->where('actif', true)->count(),
                'nb_total'      => count($modules),
            ],
            'message' => 'État des modules',
        ]);
    }

    /**
     * @OA\Post(
     *   path="/api/v1/modules/{moduleKey}/activer",
     *   summary="Activer un module",
     *   tags={"Modules"},
     *   security={{"bearerAuth":{}}},
     *   @OA\Parameter(name="moduleKey", in="path", required=true, @OA\Schema(type="string")),
     *   @OA\Response(response=200, description="Module activé")
     * )
     */
    public function activer(string $moduleKey): JsonResponse
    {
        if (!isset(TenantModule::MODULES[$moduleKey])) {
            return response()->json(['success' => false, 'message' => "Module inconnu : {$moduleKey}"], 422);
        }

        $module = TenantModule::activer(
            config('tenant.current_id'),
            $moduleKey,
            auth('api')->id()
        );

        return response()->json([
            'success' => true,
            'data'    => array_merge(TenantModule::MODULES[$moduleKey], ['actif' => true]),
            'message' => "Module « {$moduleKey} » activé avec succès ✅",
        ]);
    }

    /**
     * @OA\Post(
     *   path="/api/v1/modules/{moduleKey}/desactiver",
     *   summary="Désactiver un module",
     *   tags={"Modules"},
     *   security={{"bearerAuth":{}}},
     *   @OA\Parameter(name="moduleKey", in="path", required=true, @OA\Schema(type="string")),
     *   @OA\RequestBody(@OA\JsonContent(
     *     @OA\Property(property="raison", type="string", nullable=true,
     *       example="Nous n'avons pas de service de cantine")
     *   )),
     *   @OA\Response(response=200, description="Module désactivé"),
     *   @OA\Response(response=422, description="Module obligatoire ou inconnu")
     * )
     */
    public function desactiver(Request $request, string $moduleKey): JsonResponse
    {
        if (!isset(TenantModule::MODULES[$moduleKey])) {
            return response()->json(['success' => false, 'message' => "Module inconnu : {$moduleKey}"], 422);
        }

        try {
            TenantModule::desactiver(
                config('tenant.current_id'),
                $moduleKey,
                auth('api')->id(),
                $request->input('raison')
            );

            return response()->json([
                'success' => true,
                'data'    => array_merge(TenantModule::MODULES[$moduleKey], ['actif' => false]),
                'message' => "Module « {$moduleKey} » désactivé. Vous pouvez le réactiver à tout moment.",
            ]);
        } catch (\RuntimeException $e) {
            return response()->json(['success' => false, 'message' => $e->getMessage()], 422);
        }
    }

    /**
     * @OA\Post(
     *   path="/api/v1/modules/bulk",
     *   summary="Activer/Désactiver plusieurs modules en une fois",
     *   tags={"Modules"},
     *   security={{"bearerAuth":{}}},
     *   @OA\RequestBody(@OA\JsonContent(
     *     required={"modules"},
     *     @OA\Property(property="modules", type="object",
     *       example={"transport": true, "cantine": false, "lms": true})
     *   )),
     *   @OA\Response(response=200, description="Modules mis à jour en masse")
     * )
     */
    public function bulkUpdate(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'modules'   => 'required|array',
            'modules.*' => 'boolean',
        ]);

        $tenantId = config('tenant.current_id');
        $userId   = auth('api')->id();
        $resultats = [];
        $erreurs   = [];

        foreach ($validated['modules'] as $key => $actif) {
            if (!isset(TenantModule::MODULES[$key])) {
                $erreurs[] = "Module inconnu : {$key}";
                continue;
            }

            try {
                if ($actif) {
                    TenantModule::activer($tenantId, $key, $userId);
                } else {
                    TenantModule::desactiver($tenantId, $key, $userId);
                }
                $resultats[$key] = $actif;
            } catch (\RuntimeException $e) {
                $erreurs[] = $e->getMessage();
            }
        }

        return response()->json([
            'success'  => empty($erreurs),
            'data'     => ['mis_a_jour' => $resultats, 'erreurs' => $erreurs],
            'message'  => count($resultats) . " module(s) mis à jour" . (count($erreurs) > 0 ? " — " . count($erreurs) . " erreur(s)" : " ✅"),
        ]);
    }

    /**
     * @OA\Get(
     *   path="/api/v1/modules/actifs",
     *   summary="Liste rapide des modules actifs (pour le frontend)",
     *   tags={"Modules"},
     *   security={{"bearerAuth":{}}},
     *   @OA\Response(response=200, description="Clés des modules actifs")
     * )
     */
    public function actifs(): JsonResponse
    {
        $tenantId = config('tenant.current_id');

        // Récupérer les modules actifs + les modules jamais configurés (actifs par défaut)
        $configures = TenantModule::where('tenant_id', $tenantId)
            ->where('actif', false)
            ->pluck('module_key')
            ->toArray();

        $tousLesKeys = array_keys(TenantModule::MODULES);
        $actifsKeys  = array_filter($tousLesKeys, fn($k) => !in_array($k, $configures));

        return response()->json([
            'success' => true,
            'data'    => array_values($actifsKeys),
        ]);
    }
}
```

